Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Filtered1
        - /Erkannte Objekte1
      Splitter Ratio: 0.5
    Tree Height: 400
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:

    - Class: rviz_default_plugins/PointCloud2
      Name: Filtered
      Enabled: true
      Topic:
        Value: /microvision/pointcloud/filtered
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Color Transformer: FlatColor
      Color: 50; 220; 80
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Position Transformer: XYZ
      Use Fixed Frame: true
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Name: Erkannte Objekte
      Enabled: true
      Topic:
        Value: /dynamic_object_filter/boxes
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true

  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: MicroVisionScanTF
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera

  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 40
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: 3.14
      Name: Current View
      Near Clip Distance: 0.1
      Target Frame: MicroVisionScanTF
      Value: Orbit (rviz_default_plugins)
    Saved: ~

Window Geometry:
  Height: 900
  Width: 800
  X: 870
  Y: 50
